# MongoDB Configuration
# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/team-task-manager
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster-name.mongodb.net/team-task-manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/team-task-manager

# JWT Secret Key
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters for production
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure_minimum_32_chars

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:5173

# Database Connection Retry
# Maximum number of times to retry connecting to database
DB_RETRY_ATTEMPTS=5

# API Rate Limiting (optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
