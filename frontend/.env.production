# Production Environment Variables
# These are used during `npm run build` for Vercel/Netlify deployment

# API Base URL - Railway backend production URL
# Example: https://team-task-manager.up.railway.app/api
VITE_API_URL=https://your-railway-backend-url/api

# Environment
VITE_ENV=production

# App Title
VITE_APP_NAME=Team Task Manager

# Debugging - disable for production
VITE_DEBUG=false

# Analytics (optional)
VITE_ENABLE_ANALYTICS=true
